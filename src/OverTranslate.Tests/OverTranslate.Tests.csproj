<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Follows the application's compile-time Windows API surface — a project reference cannot
         target less than what it references. See OverTranslate.csproj for why that moved. -->
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The test host is framework-dependent, so running the suite needs a .NET 8 runtime on the
         machine and not just the SDK. A developer whose machine has a newer runtime but not 8 could
         not run the tests at all: the host exits with "You must install or update .NET" before a
         single test is collected, which reads like a broken checkout rather than a missing runtime.

         Major, not LatestMajor: this prefers the requested runtime whenever it is installed, so CI
         — which installs 8.0.x on purpose — still runs the suite on 8, and only a machine without
         it rolls forward. LatestMajor would have moved CI onto whatever the newest installed
         runtime happened to be, which is a different thing to be testing than what ships. -->
    <RollForward>Major</RollForward>
    <!-- The imaging golden cases build their inputs and read their outputs row by row through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverTranslate\OverTranslate.csproj" />
    <!-- RapidOcrNet brings the CPU onnxruntime 1.27 back in transitively; keep only the DirectML one. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Anything a test reads belongs under Fixtures. Linking a picture out of docs\images made the
         whole test project fail to build the moment that picture was replaced — those are README
         assets, kept for what they show a reader rather than for what a test asserts about them. -->
    <!-- Wins over the copy the OverTranslate reference brings along, which writes to the user's real
         log — see the comments in the file itself. -->
    <None Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
